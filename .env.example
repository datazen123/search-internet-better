# Copy to .env (never commit .env). Leave a key empty to disable that engine.
MARGINALIA_API_KEY=
# MARGINALIA_API_URL=https://...   # verify against https://about.marginalia-search.com/article/api/
BRAVE_API_KEY=
MOJEEK_API_KEY=
MOJEEK_RESULTS_PER_REQUEST=10
# Own index (server/index/). Default: data/index/local.sqlite (git-ignored).
# LOCAL_INDEX_PATH=
# URL of a page describing your crawler and how to reach you; sent in the crawler's User-Agent.
# CRAWLER_INFO_URL=
PORT=8000
